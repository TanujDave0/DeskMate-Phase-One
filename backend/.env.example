# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Backend selection: groq | openrouter | ollama
LLM_BACKEND=groq

# Ollama (used only when LLM_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=dolphin3:8b

# Groq (default)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (required for sassLevel=4 or LLM_BACKEND=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tools
TAVILY_API_KEY=
MAX_WEB_SEARCH_RESULTS=3

# Agent mode
USE_AGENT=false
MAX_AGENT_ITERATIONS=5

# Logging
LOG_FILE=logs/funbot.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
